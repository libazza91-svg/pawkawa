# Database connection
# Option A: full connection string. Use local or staging credentials in backend/.env only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Option B: individual parameters, used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petfoodcompare
DB_USER=USER
DB_PASSWORD=PASSWORD

# Server
PORT=3001

# Price comparison
PRICE_COMPARISON_FIXTURE_FALLBACK=false
