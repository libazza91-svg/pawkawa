{
  "name": "pet-food-compare-backend",
  "version": "0.1.0",
  "description": "澳新宠物食品对比平台 - 后端 API",
  "main": "src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill:retail-offers": "tsx -r dotenv/config src/scripts/backfill-retail-offers.ts",
    "admin:create-user": "tsx -r dotenv/config src/scripts/create-admin-user.ts",
    "report:offer-coverage": "tsx -r dotenv/config src/scripts/report-offer-coverage.ts",
    "cleanup:price-source-hygiene": "tsx -r dotenv/config src/scripts/cleanup-price-source-hygiene.ts",
    "gate:staging-readiness": "tsx -r dotenv/config src/scripts/gate-staging-readiness.ts",
    "seed:product-master-baseline": "tsx -r dotenv/config src/scripts/seed-product-master-baseline.ts",
    "ingest:petstock-pilot": "tsx -r dotenv/config src/scripts/ingest-petstock-pilot.ts",
    "ingest:petbarn-pilot": "tsx -r dotenv/config src/scripts/ingest-petbarn-pilot.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.22.0",
    "eslint": "^8.57.0",
    "pg-mem": "^2.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
